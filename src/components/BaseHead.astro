---
// Importa o global.css aqui para que seja incluído em todas as páginas.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import type { Alternate } from '../i18n';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	/** Links hreflang (pt-BR, en, es, x-default) — gerados via translationSlug. */
	alternates?: Alternate[];
	/** JSON-LD já serializado (BlogPosting / FAQPage) a injetar no <head>. */
	jsonLd?: string[];
}

// Canonical sempre em dualis.love (Astro.site), nunca no .vercel.app.
// Remove a barra final (exceto na raiz) para casar com hreflang e sitemap,
// que usam URLs sem trailing slash — evita sinal conflitante de canonical.
const normalizedPath = Astro.url.pathname.replace(/(.)\/$/, '$1');
const canonicalURL = new URL(normalizedPath, Astro.site);

const { title, description, image, alternates = [], jsonLd = [] } = Astro.props;
const imageSrc = typeof image === 'string' ? image : image?.src;
const ogImage = imageSrc ? new URL(imageSrc, Astro.url) : undefined;
---

<!-- Metadata global -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/blog/sitemap.xml" />
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-outfit" preload />

<!-- Canonical -->
<link rel="canonical" href={canonicalURL} />

<!-- hreflang (multi-idioma) -->
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

<!-- Meta principais -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{ogImage && <meta property="twitter:image" content={ogImage} />}

<!-- Dados estruturados (JSON-LD) -->
{jsonLd.map((block) => <script type="application/ld+json" set:html={block} />)}
