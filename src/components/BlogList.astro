---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import { blogIndexPath, getLang, postPath, UI, type LangCode } from '../i18n';

interface Props {
	lang: LangCode;
}

const { lang } = Astro.props;
const t = UI[lang];
const collection = getLang(lang).collection;
const posts = (await getCollection(collection as 'blog-pt')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const blogHome = blogIndexPath(lang);
---

<html lang={lang}>
	<head>
		<BaseHead title={`${t.blogTitle} — ${t.siteTitle}`} description={t.siteDescription} />
	</head>
	<body>
		<Header lang={lang} />
		<main>
			<section class="intro">
				<h1><span class="gradient-text">{t.siteTitle}</span></h1>
				<p>{t.siteDescription}</p>
			</section>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={postPath(lang, post.id)}>
									{post.data.heroImage && (
										<Image width={640} height={320} src={post.data.heroImage} alt={post.data.title} />
									)}
									<h2 class="title">{post.data.title}</h2>
									<p class="desc">{post.data.description}</p>
									<p class="date">
										<FormattedDate date={post.data.pubDate} lang={lang} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
				{posts.length === 0 && <p class="empty">—</p>}
			</section>
		</main>
		<Footer lang={lang} />
	</body>
</html>

<style>
	main {
		width: 1100px;
		max-width: calc(100% - 2em);
	}
	.intro {
		text-align: center;
		margin-bottom: 2.5em;
	}
	.intro p {
		color: rgb(var(--gray));
		max-width: 620px;
		margin: 0.5em auto 0;
	}
	ul {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2.5em 2em;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	ul li a {
		display: block;
		text-decoration: none;
		transition: 0.2s ease;
	}
	ul li img {
		margin-bottom: 0.8em;
		border-radius: 12px;
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 1;
		object-fit: cover;
	}
	.title {
		margin: 0;
		font-size: 1.5em;
		color: rgb(var(--black));
		line-height: 1.2;
	}
	.desc {
		color: rgb(var(--gray-dark));
		margin: 0.4em 0;
		font-size: 0.95em;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	ul li a:hover .title {
		background: var(--gradient-text);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	ul li a:hover img {
		box-shadow: var(--box-shadow);
	}
	@media (max-width: 720px) {
		ul {
			grid-template-columns: 1fr;
			gap: 2em;
		}
	}
</style>
