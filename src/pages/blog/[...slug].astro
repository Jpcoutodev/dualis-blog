---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getAlternates } from '../../i18n';

export async function getStaticPaths() {
	const posts = await getCollection('blog-pt');
	return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}
type Props = CollectionEntry<'blog-pt'>;

const post = Astro.props;
const { Content } = await render(post);
const alternates = await getAlternates('pt-BR', post.id, post.data.translationSlug);
---

<BlogPost {...post.data} lang="pt-BR" slug={post.id} alternates={alternates}>
	<Content />
</BlogPost>
